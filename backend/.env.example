# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file - it is already excluded via .gitignore.

# --- Database (required) ---
# MySQL/MariaDB connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/hirondelle_db"

# --- Server (required) ---
PORT=5556
NODE_ENV=production

# --- Security (required in production) ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, the app falls back to an insecure built-in default - fine for
# local testing only, never for a live server.
JWT_SECRET=change-me-to-a-long-random-string

# --- URLs (required) ---
# The public URL of this backend and of the frontend, used to build links in
# emails.
BACKEND_URL=https://api.your-domain.com
FRONTEND_URL=https://www.your-domain.com
