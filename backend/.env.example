# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file - it is already excluded via .gitignore.

# --- Database (required) ---
# MySQL/MariaDB connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/hirondelle_db"

# --- Server (required) ---
PORT=5556
NODE_ENV=production

# --- Security (required in production) ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, the app falls back to an insecure built-in default - fine for
# local testing only, never for a live server.
JWT_SECRET=change-me-to-a-long-random-string

# Used to encrypt saved secrets (e.g. the PayPal client secret) before they are
# stored in the database. Optional - if unset, JWT_SECRET is used instead. If
# you do set this, generate it the same way as JWT_SECRET above and keep both
# safe: losing/changing this key makes previously-saved secrets unreadable
# (just re-enter them in the admin panel in that case).
ENCRYPTION_KEY=

# --- URLs (required) ---
# The public URL of this backend and of the frontend, used to build links in
# emails and payment redirects.
BACKEND_URL=https://api.your-domain.com
FRONTEND_URL=https://www.your-domain.com

# --- PayPal (optional) ---
# You do NOT need to set these here - PayPal credentials are managed from the
# admin panel under "Flugschule Events" -> "PayPal-Einstellungen" and are
# stored encrypted in the database. These env vars only act as a fallback if
# nothing has been configured there yet.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
